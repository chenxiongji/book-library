/* pages/favorites/favorites.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

/* Tab */
.tabs {
  display: flex;
  background: #FFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #6B7280;
  border-radius: 12rpx;
}
.tab.active {
  background: rgba(74, 108, 247, 0.1);
  color: #4A6CF7;
  font-weight: 600;
}
.tab-count {
  font-size: 22rpx;
  background: #4A6CF7;
  color: #FFF;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 6rpx;
}

/* 列表 */
.fav-list {
  background: #FFF;
  border-radius: 16rpx;
  padding: 0 24rpx;
}
.fav-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}
.fav-item:last-child { border-bottom: none; }
.fav-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}
.fav-cover {
  width: 96rpx;
  height: 128rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: #F5F6FA;
}
.fav-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.fav-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.fav-title {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
}
.fav-sub {
  font-size: 24rpx;
  color: #6B7280;
}
.fav-extra {
  font-size: 24rpx;
  color: #9CA3AF;
}
.fav-time {
  font-size: 22rpx;
  color: #C0C6D0;
}
.fav-remove {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C0C6D0;
  font-size: 30rpx;
  flex-shrink: 0;
}
.fav-remove:active { color: #EF4444; }

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.empty-text {
  font-size: 30rpx;
  color: #6B7280;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #C0C6D0;
  text-align: center;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
