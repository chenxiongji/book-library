/* pages/borrow/borrow.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: linear-gradient(135deg, #4A6CF7, #6B8AFF);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-item .stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.stat-item .stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* Tab */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 500;
  transition: all 0.2s;
}

.tab-item.active {
  background: #4A6CF7;
  color: #FFFFFF;
}

/* 借阅列表 */
.borrow-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.borrow-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.borrow-card-header {
  display: flex;
  gap: 20rpx;
}

.borrow-book-cover {
  width: 100rpx;
  height: 140rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #F3F4F6;
}

.borrow-book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.borrow-book-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.borrow-dates {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.borrow-date-item {
  font-size: 22rpx;
  color: #9CA3AF;
}

.borrow-status-row {
  display: flex;
  align-items: center;
}

.borrow-status-tag {
  display: inline-flex;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.borrow-status-tag.active {
  background: rgba(74, 108, 247, 0.1);
  color: #4A6CF7;
}

.borrow-status-tag.overdue {
  background: rgba(239, 68, 68, 0.1);
  color: #EF4444;
}

.borrow-status-tag.returned {
  background: rgba(16, 185, 129, 0.1);
  color: #10B981;
}

.borrow-card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F3F4F6;
  gap: 16rpx;
}

.return-date {
  flex: 1;
  font-size: 22rpx;
  color: #9CA3AF;
}

/* 逾期罚金提示（金额来自管理端「书房设置」） */
.borrow-fine {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #E02020;
  font-weight: 600;
}
