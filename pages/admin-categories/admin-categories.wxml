<!-- pages/admin-categories/admin-categories.wxml -->
<view class="page">

  <view class="card">
    <view class="card-title">图书分类</view>
    <view class="card-tip">分类用于图书录入与书库筛选，重命名会同步更新图书信息。共 {{categories.length}} 个分类。</view>
    <view class="cell" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <text style="font-size:36rpx;margin-right:20rpx;">{{item.icon}}</text>
      <view class="cell-main">
        <view class="cell-title">{{item.name}}</view>
      </view>
      <text class="badge {{item.count ? 'badge-blue' : 'badge-gray'}}">{{item.count}} 本</text>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <view class="btn" bindtap="onAdd">＋ 新增分类</view>

</view>
