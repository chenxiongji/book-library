/* pages/note-edit/note-edit.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

/* 图书选择 */
.book-select-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.select-book-cover {
  width: 64rpx;
  height: 88rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  background: #F3F4F6;
}

.select-book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.select-book-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.select-book-author {
  font-size: 22rpx;
  color: #9CA3AF;
}

.select-arrow {
  font-size: 24rpx;
  color: #4A6CF7;
  flex-shrink: 0;
}

.select-placeholder {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.select-placeholder-icon {
  font-size: 36rpx;
}

.select-placeholder-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* 编辑卡片 */
.edit-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.title-input {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
  padding: 8rpx 0;
}

.chapter-input {
  font-size: 26rpx;
  color: #6B7280;
  padding: 8rpx 0;
}

.divider {
  height: 1rpx;
  background: #F3F4F6;
  margin: 16rpx 0;
}

.content-input {
  width: 100%;
  min-height: 400rpx;
  font-size: 28rpx;
  color: #1F2937;
  line-height: 1.8;
  padding: 8rpx 0;
}

.content-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.content-count {
  font-size: 22rpx;
  color: #D1D5DB;
}

/* 操作 */
.actions {
  display: flex;
  gap: 20rpx;
}

/* 图书选择弹窗 */
.book-picker-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.book-picker-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.book-picker {
  width: 100%;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.book-picker-overlay.show .book-picker {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx 16rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.picker-close {
  font-size: 32rpx;
  color: #9CA3AF;
  padding: 8rpx;
}

.picker-list {
  max-height: 60vh;
  padding: 0 24rpx;
}

.picker-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.picker-book-cover {
  width: 56rpx;
  height: 76rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  background: #F3F4F6;
}

.picker-book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.picker-book-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.picker-book-author {
  font-size: 22rpx;
  color: #9CA3AF;
}

.picker-book-category {
  font-size: 20rpx;
  color: #4A6CF7;
}

.btn.loading {
  opacity: 0.6;
}
