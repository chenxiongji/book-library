<!-- pages/settings/settings.wxml - 设置 -->
<view class="page">

  <!-- 账号 -->
  <view class="group">
    <view class="group-title">账号</view>
    <view class="cell" bindtap="onEditProfile">
      <view class="cell-avatar">
        <image wx:if="{{userInfo.avatar}}" class="cell-avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" />
        <view wx:else class="cell-avatar-ph"><text>{{userInfo.name ? userInfo.name[0] : '书'}}</text></view>
      </view>
      <view class="cell-main">
        <text class="cell-title">{{userInfo.name || '未设置昵称'}}</text>
        <text class="cell-sub">{{userInfo.phone || '未绑定手机号'}}</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- 阅读偏好 -->
  <view class="group">
    <view class="group-title">阅读偏好</view>

    <picker mode="selector" range="{{fontSizeLabels}}" value="{{fontSizeIndex}}" bindchange="onFontSizeChange">
      <view class="cell">
        <text class="cell-title">正文字号</text>
        <view class="cell-right">
          <text class="cell-value">{{fontSizeLabels[fontSizeIndex]}}</text>
          <text class="cell-arrow">›</text>
        </view>
      </view>
    </picker>

    <picker mode="selector" range="{{lineHeightLabels}}" value="{{lineHeightIndex}}" bindchange="onLineHeightChange">
      <view class="cell">
        <text class="cell-title">行间距</text>
        <view class="cell-right">
          <text class="cell-value">{{lineHeightLabels[lineHeightIndex]}}</text>
          <text class="cell-arrow">›</text>
        </view>
      </view>
    </picker>

    <view class="cell cell-block">
      <text class="cell-title">阅读背景</text>
      <view class="theme-row">
        <view class="theme-item {{themeKey === item.key ? 'active' : ''}}"
              wx:for="{{themeOptions}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="onThemeTap">
          <view class="theme-dot" style="background: {{item.bg}}; border-color: {{item.border}};"></view>
          <text class="theme-name">{{item.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 通知提醒 -->
  <view class="group">
    <view class="group-title">通知提醒</view>
    <view class="cell">
      <text class="cell-title">借阅到期提醒</text>
      <switch checked="{{notify.dueRemind}}" color="#4A6CF7" data-field="dueRemind" bindchange="onNotifyChange" />
    </view>
    <view class="cell">
      <text class="cell-title">新书上架通知</text>
      <switch checked="{{notify.newBook}}" color="#4A6CF7" data-field="newBook" bindchange="onNotifyChange" />
    </view>
  </view>

  <!-- 通用 -->
  <view class="group">
    <view class="group-title">通用</view>
    <view class="cell" bindtap="onClearCache">
      <text class="cell-title">清除缓存</text>
      <view class="cell-right">
        <text class="cell-value">{{cacheSize}}</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>
    <view class="cell" bindtap="onContact">
      <text class="cell-title">联系我们</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onAbout">
      <text class="cell-title">关于我们</text>
      <view class="cell-right">
        <text class="cell-value">{{version}}</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="footer-note">阳光读书 {{version}}</view>

</view>
