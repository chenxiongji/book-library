/* pages/settings/settings.wxss - 设置 */
.page {
  min-height: 100vh;
  background: #F5F6FA;
  padding-bottom: 60rpx;
}

.group {
  margin: 24rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.group-title {
  font-size: 26rpx;
  color: #9CA3AF;
  padding: 24rpx 28rpx 8rpx;
}

.cell {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 0 28rpx;
  border-top: 1rpx solid #F2F3F7;
}

.group .cell:first-of-type,
.group .cell:nth-child(2) {
  border-top: none;
}

.cell-block {
  display: block;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.cell-title {
  font-size: 30rpx;
  color: #1F2937;
  flex: 1;
}

.cell-right {
  display: flex;
  align-items: center;
}

.cell-value {
  font-size: 28rpx;
  color: #9CA3AF;
  margin-right: 8rpx;
}

.cell-arrow {
  font-size: 34rpx;
  color: #C7CBD4;
  line-height: 1;
}

/* 账号行 */
.cell-avatar {
  margin-right: 20rpx;
}

.cell-avatar-img,
.cell-avatar-ph {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
}

.cell-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4A6CF7, #6B8AFF);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
}

.cell-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.cell-main .cell-title {
  font-size: 32rpx;
  font-weight: 600;
}

.cell-sub {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}

/* 主题色选择 */
.theme-row {
  display: flex;
  margin-top: 20rpx;
}

.theme-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 36rpx;
}

.theme-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #E5E7EB;
  box-sizing: border-box;
}

.theme-item.active .theme-dot {
  box-shadow: 0 0 0 4rpx #4A6CF7;
}

.theme-name {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 10rpx;
}

.theme-item.active .theme-name {
  color: #4A6CF7;
  font-weight: 600;
}

.footer-note {
  text-align: center;
  font-size: 24rpx;
  color: #C7CBD4;
  margin-top: 60rpx;
}
