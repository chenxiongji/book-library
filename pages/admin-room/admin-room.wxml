<!-- pages/admin-room/admin-room.wxml -->
<view class="page">

  <view class="card" wx:if="{{rooms.length}}">
    <view class="card-title">书房列表</view>
    <view class="cell" wx:for="{{rooms}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <text style="font-size:36rpx;margin-right:20rpx;">🏠</text>
      <view class="cell-main">
        <view class="cell-title">
          <text>{{item.name}}</text>
          <text class="badge {{item.status === 'open' ? 'badge-green' : 'badge-red'}}">{{item.status === 'open' ? '开放中' : '临时闭馆'}}</text>
        </view>
        <view class="cell-sub">{{item.address}} · {{item.openTime}} · 座位 {{item.seats}}</view>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!rooms.length && !editor}}">
    <view class="empty-icon">🏠</view>
    <view>还没有书房，点击下方按钮创建</view>
  </view>

  <!-- 编辑器 -->
  <view class="card" wx:if="{{editor}}">
    <view class="card-title">{{editor.isNew ? '新增书房' : '编辑书房'}}</view>

    <view class="form-item">
      <view class="form-label">书房名称<text class="req">*</text></view>
      <input class="form-input" placeholder="如：阳光读书·总馆" value="{{editor.name}}" data-field="name" bindinput="bindField" />
    </view>

    <view class="form-item">
      <view class="form-label">地址</view>
      <input class="form-input" placeholder="书房详细地址" value="{{editor.address}}" data-field="address" bindinput="bindField" />
    </view>

    <view class="form-item">
      <view class="form-label">开放时间</view>
      <input class="form-input" placeholder="如：09:00 - 21:00" value="{{editor.openTime}}" data-field="openTime" bindinput="bindField" />
    </view>

    <view class="form-item">
      <view class="form-label">座位数</view>
      <input class="form-input" type="number" placeholder="如：60" value="{{editor.seats}}" data-field="seats" bindinput="bindField" />
    </view>

    <view class="btn-row">
      <view class="btn ghost" bindtap="onCancel">取消</view>
      <view class="btn" bindtap="onSave">保存</view>
    </view>
  </view>

  <view class="btn" wx:if="{{!editor}}" bindtap="onAdd">＋ 新增书房</view>

</view>
