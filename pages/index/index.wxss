/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部区域 */
.header {
  position: relative;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 240rpx;
  background: linear-gradient(135deg, #4A6CF7, #6B8AFF);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  padding: 40rpx 24rpx 0;
}

.user-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.greeting {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.user-badge-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-points {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.search-trigger {
  flex: 1;
  max-width: 400rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.95);
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  font-size: 28rpx;
}

.search-placeholder {
  font-size: 24rpx;
  color: #9CA3AF;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 24rpx;
  padding: 28rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
}

.stat-label {
  font-size: 22rpx;
  color: #9CA3AF;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #E5E7EB;
}

/* 轮播图 */
.banner-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.banner-swiper {
  height: 180rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  padding: 0 40rpx;
  border-radius: 24rpx;
}

.banner-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.banner-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.banner-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.banner-emoji {
  font-size: 64rpx;
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}

.quick-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.quick-action-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-action-emoji {
  font-size: 44rpx;
}

.quick-action-name {
  font-size: 24rpx;
  color: #4B5563;
  font-weight: 500;
}

/* 通用 section */
.section {
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.section-more {
  font-size: 24rpx;
  color: #4A6CF7;
}

/* 分类导航 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  width: calc((100% - 112rpx) / 8);
  min-width: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
}

.category-icon {
  font-size: 36rpx;
}

.category-name {
  font-size: 20rpx;
  color: #6B7280;
}

/* 推荐图书滚动 */
.recommend-scroll {
  width: 100%;
}

.recommend-list {
  display: flex;
  gap: 20rpx;
  padding: 4rpx;
}

.recommend-item {
  width: 220rpx;
  flex-shrink: 0;
}

/* 最新图书网格 */
.new-books-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.new-book-item {
  width: calc((100% - 20rpx) / 2);
}

/* 热门笔记 */
.hot-notes {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hot-note-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.hot-note-header {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.hot-note-cover {
  width: 64rpx;
  height: 80rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #F3F4F6;
}

.hot-note-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
  min-width: 0;
}

.hot-note-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.hot-note-book {
  font-size: 22rpx;
  color: #9CA3AF;
}

.hot-note-content {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.hot-note-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hot-note-author {
  font-size: 22rpx;
  color: #9CA3AF;
}

.hot-note-stats {
  display: flex;
  gap: 16rpx;
}

.stat-icon {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* 底部 */
.footer-tip {
  text-align: center;
  padding: 40rpx 0 20rpx;
  font-size: 22rpx;
  color: #D1D5DB;
}
