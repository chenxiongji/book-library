/* pages/note-detail/note-detail.wxss */
.page {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  padding-bottom: 120rpx;
}

/* 用户信息 */
.user-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.note-time {
  font-size: 22rpx;
  color: #9CA3AF;
}

.follow-btn {
  padding: 12rpx 32rpx;
  background: rgba(74, 108, 247, 0.1);
  border-radius: 24rpx;
}

.follow-btn text {
  font-size: 24rpx;
  color: #4A6CF7;
  font-weight: 500;
}

/* 笔记内容 */
.content-section {
  margin-bottom: 32rpx;
}

.note-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.note-content-box {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.note-content {
  font-size: 30rpx;
  color: #374151;
  line-height: 2;
}

/* 关联图书 */
.book-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.book-cover {
  width: 72rpx;
  height: 96rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #F3F4F6;
}

.book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.book-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.book-chapter {
  font-size: 22rpx;
  color: #9CA3AF;
}

.book-action {
  font-size: 22rpx;
  color: #4A6CF7;
}

/* 互动栏 */
.interaction-section {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.interaction-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: transparent;
  border: none;
  line-height: normal;
}

.interaction-item::after {
  border: none;
}

.interaction-icon {
  font-size: 36rpx;
}

.interaction-count {
  font-size: 26rpx;
  color: #6B7280;
}

.interaction-item.liked .interaction-count {
  color: #EF4444;
  font-weight: 600;
}

.share-btn {
  font-size: inherit;
  font-weight: inherit;
}
