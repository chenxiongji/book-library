<!-- pages/admin-notices/admin-notices.wxml -->
<view class="page">

  <view class="card" wx:if="{{notices.length}}">
    <view class="card-title">公告列表</view>
    <view class="card-tip">点击公告可置顶、编辑或删除；开关控制发布/下架。</view>

    <view class="cell" wx:for="{{notices}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="cell-main">
        <view class="cell-title">
          <text>{{item.title}}</text>
          <text class="badge badge-orange" wx:if="{{item.pinned}}">置顶</text>
          <text class="badge badge-gray" wx:if="{{!item.published}}">未发布</text>
        </view>
        <view class="cell-sub">{{item.content}}</view>
        <view class="cell-sub">{{item.createdAt}}</view>
      </view>
      <switch checked="{{item.published}}" color="#4A6CF7" catchchange="onTogglePublish" data-id="{{item.id}}" />
    </view>
  </view>

  <view class="empty" wx:if="{{!notices.length && !editor}}">
    <view class="empty-icon">📢</view>
    <view>还没有公告，点击下方按钮发布</view>
  </view>

  <!-- 编辑器 -->
  <view class="card" wx:if="{{editor}}">
    <view class="card-title">{{editor.isNew ? '发布公告' : '编辑公告'}}</view>

    <view class="form-item">
      <view class="form-label">标题<text class="req">*</text></view>
      <input class="form-input" placeholder="公告标题" value="{{editor.title}}" bindinput="bindTitle" />
    </view>

    <view class="form-item">
      <view class="form-label">内容<text class="req">*</text></view>
      <textarea class="form-textarea" placeholder="公告正文内容" value="{{editor.content}}" bindinput="bindContent" maxlength="500" />
    </view>

    <view class="switch-row">
      <view class="cell-main">
        <view class="cell-title">置顶显示</view>
        <view class="cell-sub">置顶公告将显示在列表最前面</view>
      </view>
      <switch checked="{{editor.pinned}}" color="#4A6CF7" bindchange="bindPinned" />
    </view>

    <view class="btn-row">
      <view class="btn ghost" bindtap="onCancel">取消</view>
      <view class="btn" bindtap="onSave">发布</view>
    </view>
  </view>

  <view class="btn" wx:if="{{!editor}}" bindtap="onAdd">＋ 发布公告</view>

</view>
