/* pages/book-edit/book-edit.wxss */
.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 类型横幅 */
.type-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background: #EDF1FE;
  color: #4A6CF7;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.type-banner.is-electronic {
  background: #FEF4E6;
  color: #D97706;
}

.file-info {
  font-weight: 400;
  font-size: 24rpx;
  opacity: 0.85;
}

/* 表单卡片 */
.form-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  padding: 28rpx 0 8rpx;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #F3F4F6;
  gap: 20rpx;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #374151;
}

.required {
  color: #EF4444;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1F2937;
  text-align: right;
}

.form-item-readonly .form-readonly-value {
  flex: 1;
  font-size: 28rpx;
  color: #9CA3AF;
  text-align: right;
}

.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: #1F2937;
}

.picker-arrow {
  margin-left: 8rpx;
  color: #C0C4CC;
  font-size: 32rpx;
}

/* 封面选择 */
.cover-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.cover-preview {
  width: 96rpx;
  height: 128rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
}

.cover-placeholder {
  width: 96rpx;
  height: 128rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
  border: 2rpx dashed #D1D5DB;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.cover-plus {
  font-size: 40rpx;
  color: #9CA3AF;
  line-height: 1;
}

.cover-hint {
  font-size: 18rpx;
  color: #9CA3AF;
}

/* 简介 */
.form-item-textarea {
  align-items: flex-start;
  padding: 24rpx 0;
}

.form-textarea {
  flex: 1;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #1F2937;
  line-height: 1.6;
}
