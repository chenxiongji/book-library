/* pages/recharge/recharge.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* 积分余额 */
.balance-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: linear-gradient(135deg, #4A6CF7, #6B8AFF);
  border-radius: 24rpx;
  margin-bottom: 32rpx;
}

.balance-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.balance-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.balance-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.balance-level {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
}

.balance-level-text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 套餐 */
.plans-section {
  margin-bottom: 32rpx;
}

.plans-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  display: block;
  margin-bottom: 20rpx;
}

.plans-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.plan-card {
  position: relative;
  width: calc((100% - 20rpx) / 2);
  padding: 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 3rpx solid #F3F4F6;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: all 0.2s;
}

.plan-card.selected {
  border-color: #4A6CF7;
  background: rgba(74, 108, 247, 0.03);
  box-shadow: 0 4rpx 16rpx rgba(74, 108, 247, 0.15);
}

.plan-card.popular {
  border-color: #F59E0B;
}

.popular-tag {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  padding: 4rpx 16rpx;
  background: linear-gradient(135deg, #F59E0B, #FBBF24);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 0 16rpx 0 16rpx;
}

.plan-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #4B5563;
}

.plan-points {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.plan-points-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #1F2937;
}

.plan-points-unit {
  font-size: 24rpx;
  color: #9CA3AF;
}

.plan-bonus {
  padding: 4rpx 12rpx;
  background: rgba(245, 158, 11, 0.1);
  border-radius: 8rpx;
}

.plan-bonus text {
  font-size: 20rpx;
  color: #F59E0B;
  font-weight: 500;
}

.plan-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A6CF7;
}

.plan-check {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #4A6CF7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-check text {
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
}

/* 说明 */
.notice-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4B5563;
  display: block;
  margin-bottom: 16rpx;
}

.notice-item {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 0;
}

.notice-dot {
  color: #4A6CF7;
  font-size: 26rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #9CA3AF;
  line-height: 1.6;
}

/* 底部支付栏 */
.pay-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.pay-amount {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.pay-amount-label {
  font-size: 26rpx;
  color: #6B7280;
}

.pay-amount-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #EF4444;
}

.pay-btn {
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, #07C160, #06AD56);
  border-radius: 48rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

/* 支付中 */
.paying-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}

.paying-icon-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.paying-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 8rpx solid #F5F6FA;
  border-top-color: #4A6CF7;
  animation: spin 1s linear infinite;
}

.paying-emoji {
  font-size: 64rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.paying-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.paying-desc {
  font-size: 26rpx;
  color: #9CA3AF;
}

/* 成功 */
.success-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 120rpx 40rpx 40rpx;
}

.success-icon-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.success-burst {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.2), transparent 70%);
  animation: burst 0.6s ease-out;
}

@keyframes burst {
  from { transform: scale(0); opacity: 1; }
  to { transform: scale(1.5); opacity: 0; }
}

.success-emoji {
  font-size: 80rpx;
  position: relative;
  animation: bounce 0.5s ease-out;
}

@keyframes bounce {
  0% { transform: scale(0); }
  60% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.success-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 40rpx;
}

.success-info {
  width: 100%;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.success-info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.success-info-row:last-child {
  border-bottom: none;
}

.success-info-label {
  font-size: 28rpx;
  color: #9CA3AF;
}

.success-info-value {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
}

.success-info-value.highlight {
  color: #F59E0B;
  font-weight: 700;
  font-size: 32rpx;
}

.success-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}
