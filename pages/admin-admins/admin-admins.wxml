<!-- pages/admin-admins/admin-admins.wxml -->
<view class="page">

  <view class="card">
    <view class="card-title">管理员列表</view>
    <view class="card-tip">超级管理员拥有全部权限，管理员可日常运营，录入员仅可录入图书。</view>

    <view class="cell" wx:for="{{admins}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="avatar">{{item.name.length ? item.name[0] : '?'}}</view>
      <view class="cell-main">
        <view class="cell-title">
          <text>{{item.name}}</text>
          <text class="badge" style="background: {{roleColors[roles.indexOf(item.role)]}}22; color: {{roleColors[roles.indexOf(item.role)]}};">{{item.role}}</text>
          <text class="badge badge-blue" wx:if="{{item.isSelf}}">我</text>
        </view>
        <view class="cell-sub">{{item.phone || '未绑定手机'}} · {{item.createdAt}} 加入</view>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- 编辑器 -->
  <view class="card" wx:if="{{editor}}">
    <view class="card-title">{{editor.isNew ? '新增管理员' : '编辑管理员'}}</view>

    <view class="form-item">
      <view class="form-label">名称<text class="req">*</text></view>
      <input class="form-input" placeholder="管理员名称" value="{{editor.name}}" bindinput="bindName" />
    </view>

    <view class="form-item">
      <view class="form-label">角色</view>
      <picker mode="selector" range="{{roles}}" value="{{editor.roleIndex}}" bindchange="bindRole">
        <view class="form-picker">
          <text>{{roles[editor.roleIndex]}}</text>
          <text class="arrow">▾</text>
        </view>
      </picker>
    </view>

    <view class="btn-row">
      <view class="btn ghost" bindtap="onCancel">取消</view>
      <view class="btn" bindtap="onSave">保存</view>
    </view>
  </view>

  <view class="btn" wx:if="{{!editor}}" bindtap="onAdd">＋ 新增管理员</view>

</view>
