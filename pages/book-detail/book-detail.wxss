/* pages/book-detail/book-detail.wxss */
.page {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 头部 */
.book-header {
  position: relative;
  overflow: hidden;
  padding-bottom: 32rpx;
}

.header-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 400rpx;
  border-radius: 0 0 48rpx 48rpx;
}

.book-header-content {
  position: relative;
  display: flex;
  gap: 24rpx;
  padding: 60rpx 32rpx 0;
}

.book-cover-lg {
  width: 200rpx;
  height: 280rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  flex-shrink: 0;
  background: #F3F4F6;
}

.book-header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 8rpx;
  min-width: 0;
}

.book-title-lg {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.3;
}

.book-author-lg {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.book-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 12rpx 0;
}

.book-meta-row {
  display: flex;
  gap: 12rpx;
  font-size: 22rpx;
}

.meta-label {
  color: rgba(255, 255, 255, 0.6);
  width: 100rpx;
}

.meta-value {
  color: rgba(255, 255, 255, 0.9);
  flex: 1;
}

/* 借阅状态 */
.status-card,
.progress-card {
  margin: 24rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.status-card-header,
.progress-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.status-card-title,
.progress-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.status-badge {
  padding: 4rpx 16rpx;
  background: rgba(16, 185, 129, 0.1);
  color: #10B981;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-badge.overdue {
  background: rgba(239, 68, 68, 0.1);
  color: #EF4444;
}

.status-info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.status-info-row:last-of-type {
  border-bottom: none;
}

.status-info-label {
  font-size: 26rpx;
  color: #9CA3AF;
}

.status-info-value {
  font-size: 26rpx;
  color: #1F2937;
  font-weight: 500;
}

/* 阅读进度 */
.progress-percent-lg {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A6CF7;
}

.progress-bar-large {
  height: 16rpx;
  background: #F5F6FA;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-chapter {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* 通用卡片 */
.section-card {
  margin: 24rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
  margin-bottom: 16rpx;
}

.section-card-header .section-card-title {
  margin-bottom: 0;
}

.section-card-more {
  font-size: 24rpx;
  color: #4A6CF7;
}

.book-description {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.8;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #9CA3AF;
}

.info-value {
  font-size: 26rpx;
  color: #1F2937;
  font-weight: 500;
}

/* 笔记列表 */
.note-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.note-item {
  padding: 16rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.note-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
  margin-bottom: 8rpx;
}

.note-item-content {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
  display: block;
  margin-bottom: 8rpx;
}

.note-item-footer {
  display: flex;
  justify-content: space-between;
}

.note-item-author {
  font-size: 22rpx;
  color: #9CA3AF;
}

.note-item-likes {
  font-size: 22rpx;
  color: #EF4444;
}

/* 相关推荐 */
.related-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.related-item {
  width: calc((100% - 20rpx) / 2);
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

/* 编辑按钮（窄） */
.btn-edit {
  flex: 0 0 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.btn-fav-active {
  color: #F59E0B;
}
